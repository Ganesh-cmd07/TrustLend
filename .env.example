# Spring Datasource Configuration (MySQL / Aiven / Local)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/trustlend?createDatabaseIfNotExist=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# Authentication & CORS
# TRUSTLEND_JWT_SECRET must be at least 32 UTF-8 bytes (Base64 encoded string recommended)
TRUSTLEND_JWT_SECRET=your-secure-base64-encoded-jwt-secret-min-32-bytes
TRUSTLEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Administrator Bootstrap (Optional: password must be between 12 and 72 characters if provided)
TRUSTLEND_ADMIN_EMAIL=admin@trustlend.local
TRUSTLEND_ADMIN_NAME=TrustLend Administrator
TRUSTLEND_ADMIN_PASSWORD=your_secure_admin_password_12_chars_min

# AI Provider Configuration (Google Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
TRUSTLEND_AI_CHAT_MODEL=gemini-2.5-flash
TRUSTLEND_AI_EMBEDDING_MODEL=gemini-embedding-001

# Application Server Ports
BACKEND_PORT=4040
FRONTEND_PORT=5173
